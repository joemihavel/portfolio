---
// The wall.
//
// This used to be a pannable, zoomable world larger than the screen. It is now
// exactly the viewport: every card is visible at once, arranged around the
// hero, so there is nothing to pan to and none of that machinery earns its
// place. What is left is a backdrop and a container the cards go into.
---

<div class="mw-viewport" id="mw-viewport">
  <!-- Paint trail. Its own layer between the backdrop and the cards, so a
       stroke washes over the wall without ever washing over a card. A canvas
       rather than DOM nodes: this redraws every frame, and 60 divs a second
       would thrash layout. -->
  <canvas class="mw-paint" id="mw-paint" aria-hidden="true"></canvas>
  <div class="mw-world" id="mw-world"></div>
</div>

<style>
  .mw-viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 1px 1px,
        color-mix(in srgb, var(--text-primary) 13%, transparent) 1px,
        transparent 0
      );
    background-size: 28px 28px;
    /* Dragging a card must not also drag-select the page. Cards opt their own
       text back in below. */
    user-select: none;
    -webkit-user-select: none;
  }

  .mw-paint {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* One GPU blur over the whole layer is what turns discrete dabs into a
       wash. */
    filter: blur(6px);
  }

  .mw-world {
    position: absolute;
    inset: 0;
    /* Above the paint, below the hero. */
    z-index: 1;
  }

  .mw-world :global(.mw-post-message),
  .mw-world :global(.mw-post-kicker) {
    user-select: text;
    -webkit-user-select: text;
  }
</style>

<script>
  // Double-tap an empty patch of wall to write one.
  //
  // Detected by hand rather than with dblclick: that event never fires on
  // touch, which is where the gesture is most natural.
  const initCanvas = () => {
    const vp = document.getElementById("mw-viewport");
    if (!vp) return;

    let lastTap = 0;
    let lastX = 0;
    let lastY = 0;

    vp.addEventListener("pointerup", (e) => {
      if ((e.target as HTMLElement).closest(".mw-post, a, button, dialog")) return;

      const near = Math.abs(e.clientX - lastX) < 24 && Math.abs(e.clientY - lastY) < 24;
      // 450ms rather than something tighter: the platform double-click interval
      // is around half a second, and a stricter window feels broken at normal
      // tapping speed.
      if (e.timeStamp - lastTap < 450 && near) {
        lastTap = 0;
        document.querySelector<HTMLElement>("[data-open-composer]")?.click();
        return;
      }

      lastTap = e.timeStamp;
      lastX = e.clientX;
      lastY = e.clientY;
    });
  };

  document.addEventListener("astro:page-load", initCanvas);
</script>
