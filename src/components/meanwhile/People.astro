---
// The human half of the wall: the composer, and the coloured cards it makes.
//
// Post cards are rendered client-side because they arrive after build. The news
// prints stay server-rendered — they are known at build time and should be in
// the HTML for anyone without JavaScript.
import { COUNTRIES } from "../../../scripts/lib/countries.mjs";
import { PAPERS } from "../../data/meanwhile/posts";



const countries = (COUNTRIES as { code: string; name: string }[])
  .map((c) => ({
    code: c.code,
    name: c.name,
    flag: String.fromCodePoint(
      ...[...c.code].map((ch) => 0x1f1e6 + ch.charCodeAt(0) - 65)
    ),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<!-- Composer. A <dialog> so focus trapping, Escape and the backdrop come from
     the platform rather than from three hundred lines of focus management. -->
<dialog id="mw-composer" class="mw-dialog" aria-labelledby="mw-composer-title">
  <form method="dialog" id="mw-post-form" class="mw-sheet">
   <div class="mw-sheet-paper">
    <button
      type="button"
      class="mw-close"
      data-close
      aria-label="Close">×</button>

    <p class="mw-eyebrow">Meanwhile, somewhere</p>
    <h2 id="mw-composer-title" class="mw-title">Something good happened. Tell us.</h2>
    <p class="mw-sub">
      It can be tiny. A nice conversation, a lucky break, a stranger being kind
      — if it made you smile, it counts.
    </p>

    <div class="mw-grid">
    <div class="mw-col">
    <label class="mw-label" for="mw-message">Your good thing</label>
    <textarea
      id="mw-message"
      name="message"
      maxlength="240"
      rows="4"
      class="mw-input mw-textarea"
      placeholder="What happened?"></textarea>
    <p class="mw-count"><span id="mw-count">0</span>/240</p>

    <div class="mt-4 grid gap-4">
      <div>
        <label class="mw-label" for="mw-name">Your name <span class="text-muted-2">(optional)</span></label>
        <input id="mw-name" name="name" maxlength="32" class="mw-input" placeholder="Someone" />
      </div>
      <div>
        <label class="mw-label" for="mw-country">Where are you?</label>
        {/* A hand-built combobox rather than <input list> + <datalist>.
            Datalist support on phones is patchy — often no suggestions appear
            at all, so you type a country, nothing resolves, and the form just
            refuses to submit with no way to tell why. */}
        <div class="mw-combo">
          <input
            id="mw-country"
            name="country"
            required
            class="mw-input"
            role="combobox"
            aria-expanded="false"
            aria-controls="mw-country-list"
            aria-autocomplete="list"
            autocomplete="off"
            autocapitalize="words"
            placeholder="Start typing…"
          />
          <ul class="mw-combo-list" id="mw-country-list" role="listbox" hidden></ul>
        </div>
      </div>
    </div>

    </div>

    <div class="mw-col">
    <div class="mw-ink-head">
      <p class="mw-label" id="mw-pad-label">Write it or draw it</p>
      <span class="mw-ink-tools">
        <button type="button" class="mw-ink-btn" id="mw-undo" disabled>Undo</button>
        <button type="button" class="mw-ink-btn" id="mw-clear" disabled>Clear</button>
      </span>
    </div>
    <canvas
      id="mw-pad"
      class="mw-pad"
      role="img"
      aria-labelledby="mw-pad-label"
    ></canvas>

    <div class="mw-swatches mt-4" id="mw-swatches" role="radiogroup" aria-label="Card colour">
      {PAPERS.map((paper, i) => (
        <button
          type="button"
          class="mw-swatch"
          role="radio"
          aria-checked={i === 0 ? "true" : "false"}
          data-paper={i}
          style={`--sw-bg:${paper.bg}; --sw-ink:${paper.ink}`}
          aria-label={`Colour ${i + 1}`}
        />
      ))}
    </div>
    </div>
    </div>

    <p class="mw-preview" id="mw-preview" hidden></p>

    <div class="mt-7 flex items-center justify-between gap-4">
      <p class="mw-footnote" id="mw-footnote">Leave a little something for someone else to find.</p>
      <button type="submit" class="mw-submit font-serif text-[17px]">
        Leave it here <span class="mw-submit-arrow inline-block" aria-hidden="true">→</span>
      </button>
    </div>
   </div>
  </form>
</dialog>

<script type="application/json" id="mw-country-data" set:html={JSON.stringify(countries)}></script>

<!-- Phone only: the wall shown as a deck.
     There is no room to scatter cards around the hero on a small screen, so
     they are stacked over it and opened as an overlay — the same shape as the
     news deck, so there is only one interaction to learn. -->
<div class="pd" id="mw-postdeck" hidden>
  <div class="pd-scrim" data-pd-close></div>

  <div class="pd-wrap">
    <div class="pd-row">
      <button type="button" class="pd-arrow" id="mw-pd-prev" aria-label="Previous">‹</button>
      <div class="pd-stack" id="mw-pd-stack"></div>
      <button type="button" class="pd-arrow" id="mw-pd-next" aria-label="Next">›</button>
    </div>

    <div class="pd-bar">
      <button type="button" class="pd-close" data-pd-close>Close</button>
    </div>
  </div>
</div>

<template id="mw-post-template">
  <article class="mw-post absolute">
    <div class="mw-post-paper">
      <div class="mw-stamp">
      <p class="mw-post-kicker"></p>
      <canvas class="mw-post-ink" aria-hidden="true" hidden></canvas>
      <p class="mw-post-message"></p>
      <div class="mw-post-foot">
        <span class="mw-post-who"></span>
        <button type="button" class="mw-react">
          <span class="mw-react-mark" aria-hidden="true">✦</span>
          <span class="mw-react-label"></span>
        </button>
      </div>
      <button type="button" class="mw-flag" title="Flag this" aria-label="Flag this post">⚐</button>
      </div>
    </div>
  </article>
</template>

<style>
  /* ------------------------------------------------------------- composer */
  /* The composer is the card you are about to make: same stamp stock, same
     perforated edge, and it takes the colour you pick so the choice is shown
     rather than described. --sheet-bg / --sheet-ink are set by the script. */
  .mw-dialog {
    margin: auto;
    width: min(760px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: none;
    background: transparent;
    --sheet-bg: #F4EFE2;
    --sheet-ink: #23324F;
  }
  .mw-dialog::backdrop {
    background: color-mix(in srgb, var(--text-primary) 45%, transparent);
    backdrop-filter: blur(3px);
  }

  /* A mask clips box-shadow, so the lift lives on this outer layer. */
  .mw-sheet {
    filter:
      drop-shadow(0 2px 3px rgba(0, 0, 0, 0.16))
      drop-shadow(0 26px 60px rgba(0, 0, 0, 0.28));
    text-align: left;
  }

  .mw-sheet-paper {
    --notch: 8px;
    --step: 24px;
    position: relative;
    padding: 34px 34px 28px;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    background: var(--sheet-bg);
    color: var(--sheet-ink);
    transition: background 0.4s ease, color 0.4s ease;
    --mask-edges:
      radial-gradient(var(--notch) at 50% 0, #0000 97%, #000) 0 0 / var(--step) 100% repeat-x,
      radial-gradient(var(--notch) at 50% 100%, #0000 97%, #000) 0 0 / var(--step) 100% repeat-x,
      radial-gradient(var(--notch) at 0 50%, #0000 97%, #000) 0 0 / 100% var(--step) repeat-y,
      radial-gradient(var(--notch) at 100% 50%, #0000 97%, #000) 0 0 / 100% var(--step) repeat-y;
    -webkit-mask: var(--mask-edges);
    -webkit-mask-composite: source-in;
    mask: var(--mask-edges);
    mask-composite: intersect;
  }

  .mw-close {
    position: absolute;
    top: 14px;
    right: 18px;
    font-size: 20px;
    line-height: 1;
    color: color-mix(in srgb, var(--sheet-ink) 45%, transparent);
    transition: color 0.2s ease;
  }
  .mw-close:hover { color: var(--sheet-ink); }

  .mw-eyebrow {
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .mw-title {
    margin-top: 10px;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3.4vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .mw-sub {
    margin-top: 10px;
    max-width: 56ch;
    font-size: 13.5px;
    line-height: 1.65;
    opacity: 0.72;
  }
  .mw-footnote {
    font-size: 11.5px;
    line-height: 1.5;
    opacity: 0.6;
  }
  .mw-footnote.is-error {
    opacity: 1;
    font-weight: 500;
  }

  .mw-grid {
    display: grid;
    gap: 26px;
    margin-top: 24px;
  }
  @media (min-width: 660px) {
    .mw-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .mw-col { min-width: 0; }

  .mw-label {
    display: block;
    margin-bottom: 7px;
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  /* Typed text is the card's own typewriter face, so the preview is literal. */
  .mw-input {
    width: 100%;
    padding: 10px 12px;
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 13.5px;
    color: var(--sheet-ink);
    background: color-mix(in srgb, var(--sheet-ink) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--sheet-ink) 22%, transparent);
    border-radius: 2px;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .mw-input::placeholder { color: color-mix(in srgb, var(--sheet-ink) 38%, transparent); }
  .mw-input:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--sheet-ink) 60%, transparent);
    background: color-mix(in srgb, var(--sheet-ink) 7%, transparent);
  }
  .mw-textarea {
    resize: none;
    line-height: 1.6;
    height: 92px;
  }
  .mw-count {
    margin-top: 5px;
    text-align: right;
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    opacity: 0.45;
  }
  .mw-count.is-near { opacity: 0.9; }

  .mw-preview {
    margin-top: 14px;
    font-size: 12px;
    opacity: 0.7;
  }

  .mw-ink-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .mw-ink-head .mw-label { margin-bottom: 7px; }
  .mw-ink-tools { display: inline-flex; gap: 12px; }
  .mw-ink-btn {
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sheet-ink);
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }
  .mw-ink-btn:hover { opacity: 1; }
  .mw-ink-btn[disabled] { opacity: 0.22; pointer-events: none; }

  .mw-pad {
    display: block;
    width: 100%;
    max-width: 340px;
    /* 2:1 always — it is the aspect the strokes are stored against. */
    aspect-ratio: 2 / 1;
    border: 1px dashed color-mix(in srgb, var(--sheet-ink) 28%, transparent);
    border-radius: 2px;
    background: color-mix(in srgb, var(--sheet-ink) 3%, transparent);
    cursor: crosshair;
    /* The pad owns the gesture; without this a drag scrolls the dialog. */
    touch-action: none;
  }

  .mw-combo { position: relative; }

  /* Inline on small screens. Absolutely positioned, it was being clipped by
     the sheet's own overflow — the suggestions existed but could not be seen
     or tapped, which made the country impossible to set on a phone. */
  .mw-combo-list {
    position: static;
    margin-top: 6px;
    max-height: 168px;
  }
  @media (min-width: 660px) {
    .mw-combo-list {
    position: absolute;
    z-index: 5;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 208px;
    overflow-y: auto;
    /* Momentum scrolling, and the list must not hand its scroll to the sheet
       behind it once it reaches the end. */
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background: var(--sheet-bg);
    border: 1px solid color-mix(in srgb, var(--sheet-ink) 26%, transparent);
    border-radius: 3px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    }
  }

  :global(.mw-combo-opt) {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 11px 12px;
    font-size: 13.5px;
    text-align: left;
    color: var(--sheet-ink);
    cursor: pointer;
  }
  :global(.mw-combo-opt + .mw-combo-opt) {
    border-top: 1px solid color-mix(in srgb, var(--sheet-ink) 10%, transparent);
  }
  :global(.mw-combo-opt:hover),
  :global(.mw-combo-opt[aria-selected="true"]) {
    background: color-mix(in srgb, var(--sheet-ink) 9%, transparent);
  }
  :global(.mw-combo-empty) {
    padding: 11px 12px;
    font-size: 13px;
    opacity: 0.6;
  }

  .mw-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* Every paper is a similar cream, so the ink is the only real difference —
     a swatch of the paper alone looked like six identical squares. The ring is
     the stock, the core is the ink. */
  .mw-swatch {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--sw-bg);
    border: 1px solid color-mix(in srgb, var(--sheet-ink) 20%, transparent);
    box-shadow: inset 0 0 0 6px var(--sw-ink);
    transition: transform 0.2s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.2s ease;
  }
  .mw-swatch:hover { transform: translateY(-2px) scale(1.06); }
  .mw-swatch[aria-checked="true"] {
    box-shadow:
      inset 0 0 0 9px var(--sw-ink),
      0 0 0 2px var(--sheet-bg),
      0 0 0 4px var(--sheet-ink);
  }

  .mw-submit {
    position: relative;
    padding-bottom: 3px;
    color: var(--sheet-ink);
    white-space: nowrap;
  }
  .mw-submit::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 1px;
    background: currentColor;
    transform-origin: left center;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .mw-submit:hover::after { transform: scaleX(1.05); }
  .mw-submit:hover .mw-submit-arrow { transform: translateX(4px); }
  .mw-submit-arrow { transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .mw-submit:disabled { opacity: 0.45; }

  /* ------------------------------------------------------- the phone deck */
  .pd {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
  }
  .pd-scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--background) 62%, transparent);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pd.is-open .pd-scrim { opacity: 1; transition: opacity 0.45s ease; }

  .pd-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 100vw;
  }
  .pd-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 0 6px;
  }
  /* Carries the footprint, so the bar below does not jump as cards change. */
  .pd-stack {
    position: relative;
    /* Same reasoning as the news deck: the arrows need their own room. */
    width: min(300px, calc(100vw - 130px));
    height: 60vh;
  }
  .pd-stack :global(.mw-post) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    cursor: default;
    transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.4s ease;
  }

  .pd-arrow {
    flex: none;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    font-size: 20px;
    line-height: 1;
    border-radius: 999px;
    color: var(--text-primary);
    background: var(--background);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--text-primary) 12%, transparent);
  }
  .pd-arrow[disabled] { opacity: 0.25; pointer-events: none; }

  .pd-bar {
    padding: 8px;
    border-radius: 999px;
    background: var(--background);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--text-primary) 14%, transparent);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.26s ease, transform 0.3s cubic-bezier(0.4, 0, 0.9, 0.4);
  }
  .pd.is-open .pd-bar {
    opacity: 1;
    transform: none;
    transition: opacity 0.4s ease 0.2s,
      transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) 0.2s;
  }
  .pd-close {
    padding: 11px 30px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--background);
    background: var(--text-primary);
  }

  /* The pile above the hero: a hint that there is something to open.
     A card in the pile is a preview, not the whole thing — tapping opens it at
     full size. So it shows a squatter scribble and three lines of text, which
     keeps its height predictable instead of varying with what someone wrote. */
  :global(.mw-post.is-piled) {
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  :global(.mw-post.is-piled .mw-post-ink) { aspect-ratio: 2.6 / 1; }
  /* Last resort on a short screen: the scribble goes rather than the card
     overlapping the headline. It is still there when the deck is opened. */
  :global(.mw-post.is-piled.is-tight .mw-post-ink) { display: none; }
  :global(.mw-post.is-piled .mw-post-message) {
    -webkit-line-clamp: 3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------------------------------------------------------- post cards */
  /* Global, because these are cloned from a <template> into the canvas at
     runtime and so never carry this component's scope attribute. */
  :global(.mw-post) {
    width: var(--card-w, 300px);
    transform: rotate(var(--rot));
    transform-origin: 50% 50%;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
    cursor: grab;
    /* The card owns the gesture, so a drag moves it instead of scrolling. */
    touch-action: none;
  }
  :global(.mw-post.is-dragging) {
    cursor: grabbing;
    transition: none;
  }

  /* Postage-stamp edge. Four radial-gradient layers, one per side, combined
     with mask-composite: intersect so each side keeps its own row of notches
     and the corners stay square. A border-image or SVG would not survive the
     card being resized by its content. */
  :global(.mw-stamp) {
    --notch: 7px;
    --step: 21px;
    position: relative;
    background: var(--paper);
    color: var(--ink);
    padding: 24px 22px 20px;
    --mask-edges:
      radial-gradient(var(--notch) at 50% 0, #0000 97%, #000) 0 0 / var(--step) 100% repeat-x,
      radial-gradient(var(--notch) at 50% 100%, #0000 97%, #000) 0 0 / var(--step) 100% repeat-x,
      radial-gradient(var(--notch) at 0 50%, #0000 97%, #000) 0 0 / 100% var(--step) repeat-y,
      radial-gradient(var(--notch) at 100% 50%, #0000 97%, #000) 0 0 / 100% var(--step) repeat-y;
    -webkit-mask: var(--mask-edges);
    -webkit-mask-composite: source-in;
    mask: var(--mask-edges);
    mask-composite: intersect;
  }

  /* A mask clips box-shadow, so the lift lives on a layer underneath. */
  :global(.mw-post-paper) {
    position: relative;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.16))
            drop-shadow(0 14px 26px rgba(0, 0, 0, 0.18));
  }

  :global(.mw-post-ink) {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    margin-bottom: 10px;
  }
  /* A scribble on its own should not leave an empty line under it. */
  :global(.mw-post-message:empty) { display: none; }

  :global(.mw-post-message) {
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 14px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  :global(.mw-post-kicker) {
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.62;
    margin-bottom: 12px;
  }
  :global(.mw-post-foot) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 16px;
    font-size: 11px;
  }
  :global(.mw-post-who) { opacity: 0.75; }


  :global(.mw-react) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 10.5px;
    color: inherit;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  :global(.mw-react:hover) {
    border-color: color-mix(in srgb, currentColor 70%, transparent);
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  :global(.mw-react.is-on) {
    background: color-mix(in srgb, currentColor 16%, transparent);
    border-color: currentColor;
  }
  :global(.mw-react-mark) {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(.mw-react.is-on .mw-react-mark) { transform: scale(1.35) rotate(72deg); }

  :global(.mw-flag) {
    position: absolute;
    top: 8px;
    right: 9px;
    font-size: 11px;
    line-height: 1;
    opacity: 0;
    color: inherit;
    transition: opacity 0.25s ease;
  }
  :global(.mw-post:hover .mw-flag) { opacity: 0.5; }
  :global(.mw-flag:hover) { opacity: 1 !important; }

  :global(.mw-post:hover) {
    transform: rotate(calc(var(--rot) * 0.2)) translateY(-5px) scale(1.02);
    z-index: 6;
  }

  /* Arrival: the wall assembles itself card by card. Delay is set inline so
     the order can be computed from where each card sits relative to the view,
     rather than baked into the stylesheet. */
  :global(.mw-post.is-populating) {
    animation: mw-populate 0.86s cubic-bezier(0.16, 1.06, 0.3, 1) both;
    animation-delay: var(--pop-d, 0ms);
  }
  /* --burst-x/y is the vector from a card's own spot back to the middle of the
     view, so every card starts bunched at the centre and is thrown outward to
     where it belongs. The spin is per-card, so they do not turn in unison. */
  @keyframes mw-populate {
    0% {
      opacity: 0;
      transform:
        translate3d(var(--burst-x, 0px), var(--burst-y, 0px), 0)
        rotate(var(--burst-r, 0deg))
        scale(0.28);
    }
    55% { opacity: 1; }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotate(var(--rot)) scale(1);
    }
  }

  /* New card lands with a small settle, so posting feels like it stuck. */
  :global(.mw-post.is-new) {
    animation: mw-land 0.62s cubic-bezier(0.34, 1.4, 0.64, 1) both;
  }
  @keyframes mw-land {
    0%   { opacity: 0; transform: rotate(var(--rot)) scale(1.16) translateY(-26px); }
    100% { opacity: 1; transform: rotate(var(--rot)) scale(1) translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mw-post), :global(.mw-react-mark), .mw-submit-arrow { transition: none; }
    :global(.mw-post:hover) { transform: rotate(var(--rot)); }
    :global(.mw-post.is-new) { animation: none; }
  }
</style>

<script>
  import {
    store,
    PAPERS,
    MAX_LENGTH,
    INK_RATIO,
    type Stroke,
    reactionLabel,
    timeAgo,
    type Post,
  } from "../../data/meanwhile/posts";
  import { arrange, cardSize, keepOut, type Rect, type Slot } from "../../data/meanwhile/arrange";

  interface CountryRow { code: string; name: string; flag: string }

  // Emitted by the component as a JSON island. Read once at module scope, so
  // both the card renderer and the composer's search share it.
  const COUNTRY_LIST: CountryRow[] = JSON.parse(
    document.getElementById("mw-country-data")?.textContent || "[]"
  );
  const NAMES = new Map<string, string>(COUNTRY_LIST.map((c) => [c.code, c.name]));
  const flagFor = (code: string) =>
    String.fromCodePoint(
      ...[...code.toUpperCase()].map((ch) => 0x1f1e6 + ch.charCodeAt(0) - 65)
    );

  const initPeople = () => {
    const world = document.getElementById("mw-world");
    const dialog = document.getElementById("mw-composer") as HTMLDialogElement | null;
    const tpl = document.getElementById("mw-post-template") as HTMLTemplateElement | null;
    if (!world || !dialog || !tpl) return;

    /* ------------------------------------------------------------- layout */
    // Slots are recomputed from the live viewport and the real hero box, so a
    // card can never end up behind the text or off the edge — which is what a
    // fixed world-coordinate layout could not guarantee at every window size.
    const rectOf = (sel: string): Rect | null => {
      const el = document.querySelector(sel);
      if (!el) return null;
      const r = el.getBoundingClientRect();
      return { x: r.left, y: r.top, w: r.width, h: r.height };
    };

    const heroRect = (): Rect => rectOf(".hero-inner") ?? { x: 0, y: 0, w: 0, h: 0 };

    /** The hero and the corner labels — everything a card must stay off. */
    const obstacles = (): Rect[] =>
      [heroRect(), rectOf(".hero-back"), rectOf(".vis-trigger")].filter(Boolean) as Rect[];

    let slots: Slot[] = [];
    const measure = () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const { w, h } = cardSize(vw, vh);
      world.style.setProperty("--card-w", `${Math.round(w)}px`);
      // The corner chrome is measured rather than assumed, so the reserved
      // area follows it if either label changes size.
      const blocked = [rectOf(".hero-back"), rectOf(".vis-trigger")].filter(Boolean) as Rect[];
      slots = arrange({ vw, vh, hero: heroRect(), cardW: w, cardH: h, blocked });
      return slots;
    };

    /**
     * Paints stored strokes onto a canvas at whatever size it currently is.
     *
     * Coordinates are normalised, so this is the only place that knows about
     * pixels — the same function draws the composer pad and every card.
     */
    const inkTo = (cv: HTMLCanvasElement, strokes: Stroke[], colour: string) => {
      const w = cv.clientWidth;
      if (!w) return;
      const h = w / INK_RATIO;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = w * dpr;
      cv.height = h * dpr;

      const c = cv.getContext("2d");
      if (!c) return;
      c.setTransform(dpr, 0, 0, dpr, 0, 0);
      c.clearRect(0, 0, w, h);
      c.strokeStyle = colour;
      c.lineCap = "round";
      c.lineJoin = "round";
      // Scales with the card so a scribble keeps its weight when shrunk.
      c.lineWidth = Math.max(1.6, w / 110);

      for (const stroke of strokes) {
        if (!stroke.length) continue;
        c.beginPath();
        if (stroke.length === 1) {
          // A single tap is a dot, not a zero-length line that draws nothing.
          c.arc(stroke[0][0] * w, stroke[0][1] * h, c.lineWidth / 2, 0, Math.PI * 2);
          c.fillStyle = colour;
          c.fill();
          continue;
        }
        c.moveTo(stroke[0][0] * w, stroke[0][1] * h);
        for (let i = 1; i < stroke.length; i++) {
          c.lineTo(stroke[i][0] * w, stroke[i][1] * h);
        }
        c.stroke();
      }
    };

    /* ------------------------------------------------------------- render */
    const render = (post: Post, isNew = false, target: HTMLElement = world) => {
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const paper = PAPERS[post.paper % PAPERS.length];

      node.dataset.post = post.id;
      // Stored x/y are ignored: they were world coordinates for a canvas that
      // could be panned. The wall is the viewport now, so position comes from
      // the slot this card was given.
      node.style.setProperty("--rot", "0deg");
      node.style.setProperty("--paper", paper.bg);
      node.style.setProperty("--ink", paper.ink);
      if (isNew) node.classList.add("is-new");

      const code = post.country;
      node.querySelector(".mw-post-kicker")!.textContent =
        `${flagFor(code)} ${NAMES.get(code) ?? code} · ${timeAgo(post.created_at)}`;
      // textContent, never innerHTML: this is a stranger's text.
      node.querySelector(".mw-post-message")!.textContent = post.message;
      node.querySelector(".mw-post-who")!.textContent = `— ${post.name || "Someone"}`;

      const react = node.querySelector(".mw-react") as HTMLButtonElement;
      const label = node.querySelector(".mw-react-label")!;
      const paint = (n: number, on: boolean) => {
        label.textContent = reactionLabel(n);
        react.classList.toggle("is-on", on);
        react.setAttribute("aria-pressed", String(on));
      };
      paint(post.reactions, !!post.reacted);

      let busy = false;
      react.addEventListener("click", async (e) => {
        e.stopPropagation();
        // The server is the source of truth for the count, so a double-click
        // must not fire two writes and then paint the loser's answer.
        if (busy) return;
        busy = true;

        const on = !react.classList.contains("is-on");
        // Painted before the write lands so the tap feels instant.
        paint(post.reactions + (on ? 1 : -1), on);

        const n = await store.react(post.id, on);
        post.reactions = n;
        post.reacted = on;
        paint(n, on);
        busy = false;
      });

      node.querySelector(".mw-flag")!.addEventListener("click", async (e) => {
        e.stopPropagation();
        if (!confirm("Flag this as not belonging here?")) return;

        const gone = await store.flag(post.id);
        // Removed locally either way: you have said you do not want to see it.
        // It only leaves the wall for everyone once enough others agree.
        node.remove();
        onWall = onWall.filter((p) => p.id !== post.id);
        if (!gone) return;
      });

      target.appendChild(node);

      // Drawn after the card is in the document, because the canvas sizes
      // itself from its laid-out width.
      if (post.strokes?.length) {
        const ink = node.querySelector(".mw-post-ink") as HTMLCanvasElement;
        ink.hidden = false;
        inkTo(ink, post.strokes, paper.ink);
      }

      return node;
    };

    /* -------------------------------------------------------------- the wall */
    // Only as many as there are slots, newest first — the wall shows what is
    // recent rather than everything ever written.
    let onWall: Post[] = [];

    const isPhone = () => matchMedia("(max-width: 640px)").matches;

    /* ------------------------------------------------------- the phone deck */
    const pd = document.getElementById("mw-postdeck")!;
    const pdStack = document.getElementById("mw-pd-stack")!;
    const pdPrev = document.getElementById("mw-pd-prev") as HTMLButtonElement;
    const pdNext = document.getElementById("mw-pd-next") as HTMLButtonElement;
    let pdIndex = 0;

    /** Lays the overlay's cards out as a pile, exactly like the news deck. */
    const pdLayout = () => {
      const cards = [...pdStack.querySelectorAll<HTMLElement>(".mw-post")];
      cards.forEach((card, i) => {
        const d = i - pdIndex;
        if (d < 0) {
          // Already seen: thrown off to the side rather than hidden, so going
          // back can bring it in from where it went.
          card.style.transform = "translate3d(-120%, -12px, 0) rotate(-14deg)";
          card.style.opacity = "0";
          card.style.pointerEvents = "none";
          return;
        }
        const visible = d <= 3;
        card.style.transform =
          `translate3d(0, ${d * 12}px, 0) scale(${1 - d * 0.05}) ` +
          `rotate(${d === 0 ? 0 : (d % 2 ? 1 : -1) * (0.8 + d * 0.4)}deg)`;
        card.style.opacity = visible ? "1" : "0";
        card.style.zIndex = String(cards.length - i);
        card.style.pointerEvents = d === 0 ? "auto" : "none";
      });

      pdPrev.disabled = pdIndex === 0;
      pdNext.disabled = pdIndex >= cards.length - 1;
    };

    const pdOpen = () => {
      pdStack.textContent = "";
      // Newest first, same order as the wall.
      for (const post of onWall) render(post, false, pdStack);
      pdIndex = 0;
      pd.hidden = false;
      pdLayout();
      // Committed by a reflow, not a frame: a delayed frame would leave the
      // overlay open but still transparent.
      void pd.offsetHeight;
      pd.classList.add("is-open");
    };

    const pdClose = () => {
      pd.classList.remove("is-open");
      setTimeout(() => { pd.hidden = true; }, 300);
    };

    pdNext.addEventListener("click", () => { pdIndex++; pdLayout(); });
    pdPrev.addEventListener("click", () => { pdIndex--; pdLayout(); });
    for (const el of pd.querySelectorAll("[data-pd-close]")) {
      el.addEventListener("click", pdClose);
    }
    document.addEventListener("keydown", (e) => {
      if (pd.hidden) return;
      if (e.key === "Escape") pdClose();
      if (e.key === "ArrowRight" && !pdNext.disabled) { pdIndex++; pdLayout(); }
      if (e.key === "ArrowLeft" && !pdPrev.disabled) { pdIndex--; pdLayout(); }
    });

    /** Phone: one pile in the space above the hero, tapped to open the deck. */
    const pileLayout = () => {
      world.textContent = "";
      if (!onWall.length) return;

      const topSafe = 64; // clear of the back link and the visitor count
      const gap = 20;

      // The card's height depends on what is written on it and whether it
      // carries a scribble, so the only way to know it is to build one and
      // measure. Widths are tried in turn until the pile fits the space above
      // the hero — shrinking is much better than overlapping the text.
      const widths = [Math.min(300, window.innerWidth * 0.68), 240, 200, 168];
      let chosen = widths[widths.length - 1];
      let cardH = 0;

      for (const w of widths) {
        world.style.setProperty("--card-w", `${Math.round(w)}px`);
        const probe = render(onWall[0]);
        probe.classList.add("is-piled");
        cardH = probe.offsetHeight;
        probe.remove();

        const heroTop = heroRect().y;
        if (heroTop - gap - topSafe >= cardH) {
          chosen = w;
          break;
        }
        chosen = w; // keep the smallest tried, in case none fit
      }

      world.style.setProperty("--card-w", `${Math.round(chosen)}px`);

      // Even at the smallest width the text and footer do not shrink, so on a
      // short screen the card can still be too tall. Dropping the scribble from
      // the preview always buys enough — and it is still there once opened.
      const tight = heroRect().y - gap - topSafe < cardH;

      const heroTop = heroRect().y;
      // Sits directly above the hero, or as high as it can go if the screen is
      // too short for both.
      // Measured again after the tight fallback, since dropping the scribble
      // changes the height this is positioned against.
      const probe = render(onWall[0]);
      probe.classList.add("is-piled");
      if (tight) probe.classList.add("is-tight");
      const finalH = probe.offsetHeight;
      probe.remove();

      const top = Math.max(topSafe, heroTop - gap - finalH);

      // Only the top few are drawn: the rest are invisible anyway and would
      // just cost layout on a phone.
      onWall.slice(0, 4).forEach((post, i) => {
        const node = render(post);
        node.classList.add("is-piled");
        if (tight) node.classList.add("is-tight");
        node.style.left = `calc(50% - ${Math.round(chosen / 2)}px)`;
        node.style.top = `${Math.round(top + i * 8)}px`;
        node.style.setProperty("--rot", `${(i % 2 ? 1 : -1) * (1 + i * 0.8)}deg`);
        node.style.zIndex = String(50 - i);
        node.style.opacity = i > 2 ? "0" : "1";
      });
    };

    world.addEventListener("click", (e) => {
      if (!isPhone()) return;
      const t = e.target as HTMLElement;
      if (t.closest("a, button")) return;
      if (t.closest(".mw-post")) pdOpen();
    });

    const layout = (burst = false) => {
      if (isPhone()) {
        pileLayout();
        if (burst) explode();
        return;
      }
      measure();
      const shown = onWall.slice(0, slots.length);

      world.textContent = "";
      const nodes = shown.map((post) => render(post));

      // Slots are sized for a typical card, but a card carrying a scribble is
      // roughly twice as tall — placing it on that assumption pushed it off the
      // bottom of the screen. Heights are only knowable once the card is in the
      // document, so position is corrected in a second pass.
      const edge = 12;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const blocks = obstacles();

      nodes.forEach((node, i) => {
        const slot = slots[i];
        const w = node.offsetWidth;
        const h = node.offsetHeight;

        // Keep the slot's centre, so a tall card grows about its position
        // rather than hanging off the bottom of it.
        const assumedH = cardSize(vw, vh).h;
        let x = slot.x;
        let y = slot.y + (assumedH - h) / 2;

        x = Math.min(vw - w - edge, Math.max(edge, x));
        y = Math.min(vh - h - edge, Math.max(edge, y));

        // Its real footprint may now reach the hero even though the slot did
        // not, so it is pushed clear and clamped again.
        const pushed = keepOut({ x, y, w, h }, blocks);
        x = Math.min(vw - w - edge, Math.max(edge, pushed.x));
        y = Math.min(vh - h - edge, Math.max(edge, pushed.y));

        node.style.left = `${Math.round(x)}px`;
        node.style.top = `${Math.round(y)}px`;
        node.style.setProperty("--rot", `${slot.rotation}deg`);
        // Newest sits on top, so a card arriving overlaps the ones it joins
        // rather than sliding underneath them.
        node.style.zIndex = String(100 - i);
      });

      if (burst) explode();
    };

    /* -------------------------------------------------------------- dragging */
    // Desktop only. On a phone the pile is tapped to open the deck, and there
    // is nowhere to drag a card to anyway.
    let drag: { el: HTMLElement; id: number; dx: number; dy: number; shifted: boolean } | null = null;

    world.addEventListener("pointerdown", (e) => {
      if (isPhone()) return;
      const el = (e.target as HTMLElement).closest<HTMLElement>(".mw-post");
      if (!el) return;
      // Links and buttons keep their own behaviour.
      if ((e.target as HTMLElement).closest("a, button")) return;

      drag = {
        el,
        id: e.pointerId,
        dx: e.clientX - el.offsetLeft,
        dy: e.clientY - el.offsetTop,
        shifted: false,
      };
      el.setPointerCapture(e.pointerId);
      el.classList.add("is-dragging");
      // Whatever you are holding belongs on top.
      el.style.zIndex = "200";
    });

    world.addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id) return;

      const { w, h } = cardSize(window.innerWidth, window.innerHeight);
      const realH = drag.el.offsetHeight || h;

      // Clamped, because there is nowhere off-screen to put a card any more —
      // dragging one past the edge would simply lose it.
      const clamp = (px: number, py: number) => ({
        x: Math.min(window.innerWidth - w - 8, Math.max(8, px)),
        y: Math.min(window.innerHeight - realH - 8, Math.max(8, py)),
      });

      let { x, y } = clamp(e.clientX - drag.dx, e.clientY - drag.dy);

      // The hero and the corner labels push back, so a card slides around the
      // headline instead of being dragged across it.
      const pushed = keepOut({ x, y, w, h: realH }, obstacles());
      ({ x, y } = clamp(pushed.x, pushed.y));

      if (!drag.shifted && Math.abs(x - drag.el.offsetLeft) + Math.abs(y - drag.el.offsetTop) < 3) {
        return;
      }
      drag.shifted = true;
      drag.el.style.left = `${x}px`;
      drag.el.style.top = `${y}px`;
    });

    const endDrag = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      drag.el.classList.remove("is-dragging");
      drag = null;
    };
    world.addEventListener("pointerup", endDrag);
    world.addEventListener("pointercancel", endDrag);

    /** Throws the cards out from the middle of the screen to their places. */
    const explode = () => {
      const cards = [...world.querySelectorAll<HTMLElement>(".mw-post")];
      if (!cards.length) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;

      cards
        .map((el) => ({
          el,
          d: Math.hypot(el.offsetLeft - cx, el.offsetTop - cy),
        }))
        // Nearest first, so it reads as travelling outward.
        .sort((a, b) => a.d - b.d)
        .forEach(({ el }, i) => {
          el.classList.remove("is-populating");
          void el.offsetWidth; // restart if it is already running

          // Start most of the way back to the centre, not exactly on it: a
          // perfect stack looks like a single card, and the slight spread is
          // what makes the scatter legible as it flies apart.
          el.style.setProperty("--burst-x", `${Math.round((cx - el.offsetLeft) * 0.88)}px`);
          el.style.setProperty("--burst-y", `${Math.round((cy - el.offsetTop) * 0.88)}px`);
          el.style.setProperty("--burst-r", `${((i * 37) % 60) - 30}deg`);
          el.style.setProperty("--pop-d", `${Math.min(i * 42, 900)}ms`);
          el.classList.add("is-populating");

          el.addEventListener(
            "animationend",
            () => {
              el.classList.remove("is-populating");
              for (const prop of ["--pop-d", "--burst-x", "--burst-y", "--burst-r"]) {
                el.style.removeProperty(prop);
              }
            },
            { once: true }
          );
        });
    };

    (async () => {
      onWall = await store.list();
      layout(true);
    })();

    // Slots depend on the viewport and on where the hero actually sits, so a
    // resize has to re-run the whole arrangement.
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => layout(false), 150);
    });

    /* ----------------------------------------------------------- composer */
    const form = document.getElementById("mw-post-form") as HTMLFormElement;
    const message = document.getElementById("mw-message") as HTMLTextAreaElement;
    const nameEl = document.getElementById("mw-name") as HTMLInputElement;
    const country = document.getElementById("mw-country") as HTMLInputElement;
    const count = document.getElementById("mw-count")!;
    const preview = document.getElementById("mw-preview")!;

    /* ------------------------------------------------------------- country */
    const list = document.getElementById("mw-country-list")!;
    let chosen: CountryRow | null = null;
    let active = -1;

    const matches = (q: string) => {
      const needle = q.trim().toLowerCase();
      if (!needle) return COUNTRY_LIST.slice(0, 8);
      // Names that start with the query first, then names that merely contain
      // it — so "ind" offers India before Indonesia rather than alphabetically.
      const starts = COUNTRY_LIST.filter((c) => c.name.toLowerCase().startsWith(needle));
      const has = COUNTRY_LIST.filter(
        (c) => !c.name.toLowerCase().startsWith(needle) && c.name.toLowerCase().includes(needle)
      );
      return [...starts, ...has].slice(0, 8);
    };

    const closeList = () => {
      list.hidden = true;
      country.setAttribute("aria-expanded", "false");
      active = -1;
    };

    const pick = (c: CountryRow) => {
      chosen = c;
      country.value = `${c.flag} ${c.name}`;
      country.setCustomValidity("");
      closeList();
      sync();
    };

    const openList = () => {
      const found = matches(country.value);
      list.textContent = "";

      if (!found.length) {
        const empty = document.createElement("li");
        empty.className = "mw-combo-empty";
        empty.textContent = "No country by that name.";
        list.appendChild(empty);
      }

      found.forEach((c, i) => {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "mw-combo-opt";
        btn.setAttribute("role", "option");
        btn.setAttribute("aria-selected", String(i === active));
        btn.textContent = `${c.flag} ${c.name}`;
        // pointerdown, not click: the input's blur would close the list first
        // and the tap would land on nothing.
        btn.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          pick(c);
        });
        li.appendChild(btn);
        list.appendChild(li);
      });

      list.hidden = false;
      country.setAttribute("aria-expanded", "true");
    };

    country.addEventListener("focus", openList);
    country.addEventListener("input", () => {
      // Typing after choosing means they are choosing again.
      chosen = null;
      active = -1;
      openList();
      sync();
    });

    country.addEventListener("keydown", (e) => {
      if (list.hidden) return;
      const opts = [...list.querySelectorAll<HTMLElement>(".mw-combo-opt")];
      if (!opts.length) return;

      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        active = (active + (e.key === "ArrowDown" ? 1 : -1) + opts.length) % opts.length;
        opts.forEach((o, i) => o.setAttribute("aria-selected", String(i === active)));
        opts[active].scrollIntoView({ block: "nearest" });
      } else if (e.key === "Enter" && active >= 0) {
        e.preventDefault();
        opts[active].dispatchEvent(new Event("pointerdown"));
      } else if (e.key === "Escape") {
        closeList();
      }
    });

    country.addEventListener("blur", () => {
      // Delayed, so a tap on an option is not cancelled by the blur.
      setTimeout(closeList, 120);
    });

    /**
     * The chosen country, falling back to whatever was typed.
     *
     * Tapping a suggestion is the happy path, but requiring it made the form
     * silently unsubmittable for anyone whose suggestion list was clipped or
     * dismissed. An exact name, or a prefix that matches exactly one country,
     * is unambiguous — so accept it.
     */
    const resolveCountry = (): CountryRow | null => {
      if (chosen) return chosen;

      const typed = country.value.trim().replace(/^[^\p{L}]+/u, "").toLowerCase();
      if (!typed) return null;

      const exact = COUNTRY_LIST.find((c) => c.name.toLowerCase() === typed);
      if (exact) return exact;

      const starts = COUNTRY_LIST.filter((c) => c.name.toLowerCase().startsWith(typed));
      return starts.length === 1 ? starts[0] : null;
    };

    let paperIndex = 0;

    /* ------------------------------------------------------------- the pad */
    const pad = document.getElementById("mw-pad") as HTMLCanvasElement;
    const undoBtn = document.getElementById("mw-undo") as HTMLButtonElement;
    const clearBtn = document.getElementById("mw-clear") as HTMLButtonElement;

    let strokes: Stroke[] = [];
    let drawing: Stroke | null = null;

    const padInk = () => PAPERS[paperIndex].ink;

    /** The sheet wears the paper you picked, so the choice is shown not told. */
    const dressSheet = () => {
      const paper = PAPERS[paperIndex];
      dialog.style.setProperty("--sheet-bg", paper.bg);
      dialog.style.setProperty("--sheet-ink", paper.ink);
    };

    const repaint = () => {
      inkTo(pad, drawing ? [...strokes, drawing] : strokes, padInk());
      const empty = !strokes.length && !drawing;
      undoBtn.disabled = empty;
      clearBtn.disabled = empty;
    };

    const padPoint = (e: PointerEvent): [number, number] => {
      const r = pad.getBoundingClientRect();
      // Clamped, so a stroke that leaves the pad stops at its edge rather than
      // being stored outside the box and clipped later.
      return [
        Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)),
        Math.min(1, Math.max(0, (e.clientY - r.top) / r.height)),
      ];
    };

    pad.addEventListener("pointerdown", (e) => {
      pad.setPointerCapture(e.pointerId);
      drawing = [padPoint(e)];
      repaint();
    });

    pad.addEventListener("pointermove", (e) => {
      if (!drawing) return;
      const p = padPoint(e);
      const last = drawing[drawing.length - 1];
      // Skip samples that barely moved: they add weight to the payload and
      // nothing to the drawing.
      if (Math.hypot(p[0] - last[0], p[1] - last[1]) < 0.004) return;
      drawing.push(p);
      repaint();
    });

    const endStroke = () => {
      if (!drawing) return;
      strokes.push(drawing);
      drawing = null;
      repaint();
    };
    pad.addEventListener("pointerup", endStroke);
    pad.addEventListener("pointercancel", endStroke);

    undoBtn.addEventListener("click", () => { strokes.pop(); repaint(); });
    clearBtn.addEventListener("click", () => { strokes = []; repaint(); });

    const sync = () => {
      count.textContent = String(message.value.length);
      count.parentElement!.classList.toggle("is-near", message.value.length > MAX_LENGTH - 40);

      const c = resolveCountry();
      country.setCustomValidity(
        country.value.trim() && !c ? "Pick a country from the list" : ""
      );
      if (c) {
        preview.hidden = false;
        preview.textContent = `Will appear as: ${nameEl.value.trim() || "Someone"} \u00b7 ${c.flag} ${c.name}`;
      } else {
        preview.hidden = true;
      }
    };
    message.addEventListener("input", sync);
    nameEl.addEventListener("input", sync);
    country.addEventListener("input", sync);

    for (const sw of document.querySelectorAll<HTMLElement>(".mw-swatch")) {
      sw.addEventListener("click", () => {
        for (const o of document.querySelectorAll(".mw-swatch")) {
          o.setAttribute("aria-checked", "false");
        }
        sw.setAttribute("aria-checked", "true");
        paperIndex = Number(sw.dataset.paper);
        dressSheet();
        // The scribble is drawn in the card's ink, so it recolours too.
        repaint();
      });
    }

    const footnote = document.getElementById("mw-footnote")!;
    const restingNote = footnote.textContent ?? "";

    /**
     * Says something next to the button.
     *
     * Errors used to land in the "will appear as" line further up the sheet,
     * which on a phone is often scrolled out of view — so a rejected submit
     * looked exactly like nothing happening.
     */
    const say = (msg: string) => {
      footnote.textContent = msg;
      footnote.classList.add("is-error");
    };
    const clearSay = () => {
      footnote.textContent = restingNote;
      footnote.classList.remove("is-error");
    };

    const open = () => {
      clearSay();
      form.reset();
      chosen = null;
      closeList();
      strokes = [];
      drawing = null;
      // A different paper each time, so the wall does not fill with one colour
      // just because it happens to be first in the list.
      paperIndex = Math.floor(Math.random() * PAPERS.length);
      for (const [i, o] of [...document.querySelectorAll(".mw-swatch")].entries()) {
        o.setAttribute("aria-checked", i === paperIndex ? "true" : "false");
      }
      dressSheet();
      sync();
      dialog.showModal();
      // Sized from layout, so it has to wait for the dialog to be on screen.
      requestAnimationFrame(repaint);
      // Focus the textarea, not the close button the browser would pick.
      setTimeout(() => message.focus(), 40);
    };

    for (const el of document.querySelectorAll("[data-open-composer]")) {
      el.addEventListener("click", open);
    }
    for (const el of dialog.querySelectorAll("[data-close]")) {
      el.addEventListener("click", () => dialog.close());
    }

    form.addEventListener("submit", async (e) => {
      // method="dialog" would close before we ever see the values.
      e.preventDefault();
      const text = message.value.trim();
      const c = resolveCountry();
      // Either half is enough on its own — a scribble is a post too.
      if (!text && !strokes.length) {
        say("Write something or draw something first.");
        message.focus();
        return;
      }
      if (!c) {
        say("Pick your country from the list.");
        country.focus();
        return;
      }

      const submit = form.querySelector(".mw-submit") as HTMLButtonElement;
      submit.disabled = true;

      const result = await store.create(
        {
          message: text,
          name: nameEl.value.trim() || null,
          country: c.code,
          paper: paperIndex,
          strokes,
        }
      );

      submit.disabled = false;

      // The server can refuse — rate limit, validation, or simply being down.
      // Say so in the composer rather than closing it and losing what was
      // typed.
      if ("error" in result) {
        say(result.error);
        return;
      }

      const post = result;
      onWall.push(post);

      dialog.close();
      const node = render(post, true);
      // Fly to where it landed, so you watch your own card join the wall.
      document.dispatchEvent(
        new CustomEvent("mw:focus", { detail: { el: node, scale: 1.05 } })
      );
    });
  };

  // The canvas owns dragging; it tells us where a post ended up.
  document.addEventListener("mw:moved", (e) => {
    const d = (e as CustomEvent).detail;
    if (d?.kind === "post") store.move(d.id, d.x, d.y);
  });

  document.addEventListener("astro:page-load", initPeople);
</script>
