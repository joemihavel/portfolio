        <p class="[word-break:break-word] font-[ArchiveRoboto]  leading-[13.146px] relative shrink-0 text-[8.366px] text-[rgba(0,0,0,0.85)] text-center whitespace-nowrap font-normal" data-node-id="47:20568" style={{ fontVariationSettings: '"wdth" 100' }}>
          Learn More
        </p>
      </div>
    </div>
