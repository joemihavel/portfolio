---
// Native static UI from Flent Charter, section 47:66953.
const imgIconWrapper = "/images/archive/additions/9cb51.svg";
---

<div class="bg-white content-stretch flex items-center justify-between px-[14.341px] py-[9.561px] relative size-full" data-node-id="47:20558" data-name=".Page-Header(Legacy)">
      <div class="content-stretch flex gap-[4.78px] items-center relative shrink-0" data-node-id="47:20559">
        <div class="flex h-[5.976px] items-center justify-center relative shrink-0 w-[6.723px]" data-node-id="47:20560">
          <div class="flex-none rotate-90">
            <div class="h-[6.723px] relative w-[5.976px]" data-name="icon-wrapper">
              <img loading="lazy" decoding="async" alt="" class="absolute block inset-0 max-w-none size-full" src={imgIconWrapper} />
            </div>
          </div>
        </div>
        <div class="content-stretch flex h-[23.903px] items-center overflow-clip py-[3.585px] relative shrink-0" data-node-id="47:20563" data-name="heading-left">
          <div class="content-stretch flex items-center overflow-clip relative shrink-0" data-node-id="47:20564" data-name="wrapper">
            <p class="[word-break:break-word] font-[ArchiveRoboto]  leading-[0] relative shrink-0 text-[11.951px] text-[rgba(0,0,0,0.85)] whitespace-nowrap font-medium" data-node-id="47:20565" style={{ fontVariationSettings: '"wdth" 100' }}>
