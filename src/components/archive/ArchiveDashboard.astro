---
import ArchiveDashboardHeatmap from './ArchiveDashboardHeatmap.astro';
import ArchiveDashboardTable from './ArchiveDashboardTable.astro';
import ArchiveDashboardSidebar from './ArchiveDashboardSidebar.astro';
import ArchiveDashboardHeader from './ArchiveDashboardHeader.astro';
---
<div class="archive-dashboard" data-node-id="12:3876">
  <img class="archive-dashboard-art" src="/images/archive/c8349.webp" alt="" loading="lazy" />
  <div class="archive-dashboard-window" data-node-id="12:3878">
    <div class="archive-dashboard-glow" aria-hidden="true"></div>
    <div class="archive-dashboard-sidebar"><ArchiveDashboardSidebar /></div>
    <div class="archive-dashboard-header"><ArchiveDashboardHeader /></div>
    <div class="archive-dashboard-main">
      <div class="archive-dashboard-heatmap"><ArchiveDashboardHeatmap /></div>
      <div class="archive-dashboard-table"><ArchiveDashboardTable /></div>
    </div>
  </div>
</div>
