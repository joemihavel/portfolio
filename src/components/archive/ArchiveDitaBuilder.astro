---
import ArchiveDitaRightNav from './ArchiveDitaRightNav.astro';
import ArchiveDitaHeader from './ArchiveDitaHeader.astro';
import ArchiveDitaLeftNav from './ArchiveDitaLeftNav.astro';
import ArchiveDitaSummary from './ArchiveDitaSummary.astro';
import ArchiveDitaTreeHeader from './ArchiveDitaTreeHeader.astro';
import ArchiveDitaTopics from './ArchiveDitaTopics.astro';
import ArchiveDitaCode from './ArchiveDitaCode.astro';
import ArchiveDitaBreadcrumbs from './ArchiveDitaBreadcrumbs.astro';
---
<div class="archive-added-slide" data-node-id="47:20359">
  <img class="archive-added-background" src="/images/archive/86e79.webp" width="1024" height="576" alt="" loading="lazy" decoding="async" />
  <div class="archive-dita-app" data-node-id="47:29457">
    <div class="archive-dita-left"><ArchiveDitaLeftNav /></div>
    <div class="archive-dita-right"><ArchiveDitaRightNav /></div>
    <div class="archive-dita-breadcrumbs"><ArchiveDitaBreadcrumbs /></div>
    <div class="archive-dita-header"><ArchiveDitaHeader /></div>
    <div class="archive-dita-main">
      <div class="archive-dita-summary"><ArchiveDitaSummary /></div>
      <div class="archive-dita-columns">
        <div class="archive-dita-tree" data-node-id="47:20592">
          <div class="archive-dita-tree-header"><ArchiveDitaTreeHeader /></div>
          <div class="archive-dita-tree-body" data-node-id="47:20606">
            <div class="archive-dita-textures" aria-hidden="true">
              <img src="/images/archive/additions/dita-dots-1.png" width="273" height="152" alt="" loading="lazy" decoding="async" />
              <img src="/images/archive/additions/dita-dots-2.png" width="273" height="152" alt="" loading="lazy" decoding="async" />
              <img src="/images/archive/additions/dita-dots-3.png" width="273" height="152" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="archive-dita-topics"><ArchiveDitaTopics /></div>
          </div>
        </div>
        <div class="archive-dita-code"><ArchiveDitaCode /></div>
      </div>
    </div>
  </div>
</div>
