---
import { categories } from "../data/portfolio-content";
---

<label class="mobile-work-picker" for="mobile-work-category">
  <span>Browse</span>
  <span class="mobile-work-select">
    <select id="mobile-work-category" aria-label="Work category">
      {categories.map(({ key, label, count }) => <option value={key}>{label} ({count})</option>)}
    </select>
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </span>
</label>
