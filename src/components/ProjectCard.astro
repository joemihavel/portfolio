---
// A project on /play.
//
// A tinted block holding an inset cover image, with a small pill overlaying its
// top corner and the words centred underneath: a meta line, the title, then two
// lines of description. The card in the middle of the carousel takes the
// project's colour at full strength and flips to white type; the rest sit in a
// pale wash of it.
//
// A placeholder renders the same shape with an empty frame and skeleton bars,
// so a slot can be held without inventing a project to fill it.
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const when = project.updated
  ? new Date(project.updated).toLocaleDateString("en-GB", { month: "long", day: "numeric" })
  : "";

// The reference's "Article • 3 mins": what it is, then where it stands.
const meta = [project.label, project.status].filter(Boolean).join(" • ");

const external = project.href.startsWith("http");
const Tag = project.placeholder ? "div" : "a";
const linkProps = project.placeholder
  ? {}
  : {
      href: project.href,
      "aria-label": `${project.title} — ${project.blurb}`,
      ...(external ? { target: "_blank", rel: "noreferrer" } : {}),
    };
---

<article
  class:list={["card", { "is-soon": project.placeholder }]}
  style={`--accent-c:${project.accent}; --reveal-d:${index * 90}ms`}
>
  <Tag class="card-link" {...linkProps}>
    <div class="frame">
      {
        project.cover ? (
          <img class="cover" src={project.cover} alt="" loading="lazy" decoding="async" />
        ) : (
          <span class="cover-empty" aria-hidden="true" />
        )
      }

      {
        !project.placeholder && (
          <span class="pill">
            Open
            <svg viewBox="0 0 12 12" aria-hidden="true">
              <path
                d="M4 8 8 4M4.6 3.7H8.3V7.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        )
      }
    </div>

    <div class="body">
      <p class="meta">{meta}</p>
      <h3 class="title">{project.title}</h3>

      {
        project.placeholder ? (
          <div class="skeleton" aria-hidden="true">
            <span />
            <span />
          </div>
        ) : (
          <p class="blurb">{project.blurb}</p>
        )
      }

      {when && <p class="when">{when}</p>}
    </div>
  </Tag>
</article>

<style>
  .card {
    /* Two faces of the same colour: a pale wash at rest, and a deep version —
       mixed toward near-black so any hue in the palette, yellow included, can
       still carry white type — when the card is the one in the middle. */
    --wash: color-mix(in srgb, var(--accent-c) 15%, var(--background));
    --deep: color-mix(in srgb, var(--accent-c) 52%, #17171a);

    border-radius: 18px;
    background: var(--wash);
    border: 1px solid color-mix(in srgb, var(--accent-c) 26%, transparent);
    overflow: hidden;
    box-shadow: 0 10px 30px color-mix(in srgb, var(--text-primary) 9%, transparent);
    transition:
      background 0.5s ease,
      border-color 0.5s ease,
      color 0.5s ease;
  }

  .card-link {
    display: block;
    padding: 10px 10px 22px;
    color: inherit;
  }

  /* The image, inset far enough that the card's colour frames it. */
  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent-c) 12%, var(--background));
  }
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cover-empty {
    position: absolute;
    inset: 10px;
    border-radius: 8px;
    border: 1px dashed color-mix(in srgb, var(--text-primary) 20%, transparent);
  }

  /* Sits over the top corner of the image, as in the reference. */
  .pill {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--accent-c) 60%, #101014);
    background: color-mix(in srgb, var(--accent-c) 18%, #fff);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.14);
  }
  .pill svg {
    width: 11px;
    height: 11px;
  }

  .body {
    padding: 16px 18px 0;
    text-align: center;
  }

  .meta {
    font-size: 11px;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--text-primary) 55%, transparent);
  }

  .title {
    margin-top: 10px;
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    /* One line, so a long name shortens rather than shifting everything under
       it out of line with the neighbouring cards. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blurb {
    margin-top: 7px;
    font-size: 13.5px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--text-primary) 62%, transparent);
    /* Two lines, so every card in the row is the same height. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Two bars occupying exactly the two lines a blurb would. */
  .skeleton {
    margin-top: 7px;
    height: calc(13.5px * 1.55 * 2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }
  .skeleton span {
    width: 78%;
    height: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-primary) 11%, transparent);
  }
  .skeleton span:last-child {
    width: 52%;
  }

  .when {
    margin-top: 12px;
    font-size: 11.5px;
    color: color-mix(in srgb, var(--text-primary) 45%, transparent);
  }

  /* The card in the middle of the carousel. */
  .card.is-lead {
    background: var(--deep);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 18px 44px color-mix(in srgb, var(--accent-c) 30%, transparent);
  }
  .card.is-lead .title {
    color: #fff;
  }
  .card.is-lead .meta {
    color: rgb(255 255 255 / 0.62);
  }
  .card.is-lead .blurb {
    color: rgb(255 255 255 / 0.78);
  }
  .card.is-lead .when {
    color: rgb(255 255 255 / 0.5);
  }
  .card.is-lead .skeleton span {
    background: rgb(255 255 255 / 0.22);
  }
  .card.is-lead .cover-empty {
    border-color: rgb(255 255 255 / 0.3);
  }
  .card.is-lead .frame {
    background: rgb(255 255 255 / 0.1);
  }
  .card.is-lead .pill {
    color: color-mix(in srgb, var(--accent-c) 55%, #101014);
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
