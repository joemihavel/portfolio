---
import { resumeHref } from "../data/portfolio-content";
interface Props { current: string; }
const { current } = Astro.props;
---

<details class="mobile-navigation">
  <summary>
    <span data-mobile-nav-current>{current === "about" ? "About me" : "Home"}</span>
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </summary>
  <nav class="mobile-navigation-panel" aria-label="Main navigation">
    <a href="/" data-mobile-nav="home">Home <span aria-hidden="true">↗</span></a>
    <a href="/about" data-mobile-nav="about">About me <span aria-hidden="true">↗</span></a>
    <a href={resumeHref} data-mobile-nav="resume" target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)">Resume <span aria-hidden="true">↗</span></a>
  </nav>
</details>

<script>
  const disclosure = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
  const trigger = disclosure?.querySelector("summary");
  const closeNavigation = (restoreFocus = false) => {
    if (!disclosure?.open) return;
    disclosure.open = false;
    if (restoreFocus) trigger?.focus({ preventScroll: true });
  };
  const updateNavigation = () => {
    if (!disclosure) return;
    const view = document.documentElement.dataset.view;
    const current = view === "about" ? "about" : "home";
    const caption = disclosure.querySelector<HTMLElement>("[data-mobile-nav-current]");
    if (caption) caption.textContent = current === "about" ? "About me" : "Home";
    disclosure.querySelectorAll<HTMLAnchorElement>("[data-mobile-nav]").forEach(link => {
      const active = link.dataset.mobileNav === current;
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  };
  document.addEventListener("pointerdown", event => {
    if (event.target instanceof Node && !disclosure?.contains(event.target)) closeNavigation();
  }, { passive: true });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && disclosure?.open) {
      event.preventDefault();
      closeNavigation(true);
    }
  });
  disclosure?.addEventListener("click", event => {
    if (event.target instanceof Element && event.target.closest("a")) {
      closeNavigation();
      // Same-page section links update history without an Astro page-load event.
      requestAnimationFrame(updateNavigation);
    }
  });
  disclosure?.addEventListener("focusout", event => {
    if (event.relatedTarget instanceof Node && !disclosure.contains(event.relatedTarget)) closeNavigation();
  });
  document.addEventListener("astro:before-preparation", () => closeNavigation());
  document.addEventListener("astro:after-swap", updateNavigation);
  document.addEventListener("astro:page-load", updateNavigation);
  addEventListener("hashchange", updateNavigation);
  addEventListener("popstate", updateNavigation);
  matchMedia("(max-width: 700px)").addEventListener("change", () => closeNavigation());
</script>
