---
import { securedAssets as assets } from "../../data/secured-design-media";
const labels = [
  { value: "150", x: 84.22, y: 181.42, angle: 30 },
  { value: "300", x: 57.21, y: 155.07, angle: 60 },
  { value: "450", x: 47.63, y: 119.2, angle: 90 },
  { value: "600", x: 57.47, y: 81.89, angle: -60 },
  { value: "750", x: 84.37, y: 54.86, angle: -30 },
];
---

<span class="cover-compass-window" data-cover-compass>
  <span class="cover-stats-clear"></span>
  <span class="cover-compass-circle">
    <img class="cover-compass-ring" src={assets["cover-compass"].src} alt="" width={assets["cover-compass"].width} height={assets["cover-compass"].height} />
    <img class="cover-compass-ring cover-gauge-unfilled" src={assets["cover-compass"].src} alt="" width={assets["cover-compass"].width} height={assets["cover-compass"].height} />
    {labels.map(label => <span class="cover-compass-label" style={`left:calc(${label.x} * var(--cover-unit));top:calc(${label.y} * var(--cover-unit));transform:translate(-50%,-50%) rotate(${label.angle}deg)`}>{label.value}</span>)}
    <span class="cover-gauge-marker"><span class="cover-compass-label cover-compass-current"><span class="cover-score-number" /></span></span>
  </span>
  <img class="cover-score-stats" src={assets["cover-score-stats"].src} alt="" width={assets["cover-score-stats"].width} height={assets["cover-score-stats"].height} />
</span>
